# Public site
NEXT_PUBLIC_APP_NAME=Naruka Styling Studio
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# memory or firestore. Empty uses Firestore when admin credentials exist.
DATA_DRIVER=

# Resend sends login OTP codes and report links. Report emails contain a URL only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# QPay Merchant V2. Sandbox: https://merchant-sandbox.qpay.mn
# Production: https://merchant.qpay.mn
QPAY_BASE_URL=
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_CALLBACK_URL=
# true only with the sandbox host, or outside production. Never with https://merchant.qpay.mn
QPAY_SIMULATE=

# OpenAI text and image. Claude and Gemini are not used.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_INPUT_USD_PER_MTOK=2
OPENAI_OUTPUT_USD_PER_MTOK=8

# gpt-image-1, 1024x1536, medium quality.
IMAGE_USD_PER_IMAGE=0.063
IMAGE_INPUT_USD_PER_MTOK=0.5

# Internal cost dashboard only. Leave empty until you set a real rate.
COST_FX_MNT_PER_USD=

# First admin. Sensitive reads stay closed until the second address is set.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_SENSITIVE_EMAIL=

# Cloud Tasks -> Cloud Function or POST /api/internal/worker
GOOGLE_CLOUD_PROJECT=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=asia-east1
WORKER_URL=
WORKER_SECRET=

# Require X-Firebase-AppCheck when true
APP_CHECK_ENFORCED=false
